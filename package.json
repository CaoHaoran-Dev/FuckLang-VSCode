{
  "name": "fucklang-vscode",
  "displayName": "FuckLang for VS Code",
  "description": "Language support for FuckLang",
  "version": "1.0.0",
  "publisher": "CaoHaoran-Dev",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./client/out/extension.js",
  "activationEvents": [
    "onLanguage:fucklang",
    "onCommand:fucklang.run"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fucklang",
        "aliases": ["FuckLang", "fuck"],
        "extensions": [".fuck"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fucklang",
        "scopeName": "source.fucklang",
        "path": "./syntaxes/fucklang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fucklang",
        "path": "./snippets/fucklang.json"
      }
    ],
    "commands": [
      {
        "command": "fucklang.run",
        "title": "Run FuckLang File",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "fucklang.run",
          "when": "resourceLangId == fucklang"
        }
      ],
      "editor/context": [
        {
          "command": "fucklang.run",
          "when": "resourceLangId == fucklang",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "fucklang.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorTextFocus && resourceLangId == fucklang"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -b",
    "watch": "tsc -b -w"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}