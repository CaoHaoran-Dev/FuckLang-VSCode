{
  "name": "fucklang-vscode",
  "displayName": "FuckLang for VS Code",
  "description": "Language support for FuckLang",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fucklang",
        "aliases": [
          "FuckLang",
          "fuck"
        ],
        "extensions": [
          ".fuck"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fucklang",
        "scopeName": "source.fucklang",
        "path": "./syntaxes/fucklang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fucklang",
        "path": "./snippets/fucklang.json"
      }
    ]
  }
}