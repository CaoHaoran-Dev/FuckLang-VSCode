{
  "name": "fucklang-vscode",
  "displayName": "FuckLang for VS Code",
  "description": "Language support for FuckLang",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fucklang",
        "aliases": [
          "FuckLang",
          "fuck"
        ],
        "extensions": [
          ".fuck"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fucklang",
        "scopeName": "source.fucklang",
        "path": "./syntaxes/fucklang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fucklang",
        "path": "./snippets/fucklang.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -b",
    "watch": "tsc -b -w"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.146.0",
    "typescript": "^5.9.3"
  }
}
