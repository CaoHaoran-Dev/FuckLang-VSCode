{
  "name": "fucklang-vscode",
  "displayName": "FuckLang for VS Code",
  "description": "Language support for FuckLang",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "fucklang",
      "aliases": ["FuckLang", "fucklang"],
      "extensions": [".fuck"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "fucklang",
      "scopeName": "source.fucklang",
      "path": "./syntaxes/fucklang.tmLanguage.json"
    }]
  }
}
